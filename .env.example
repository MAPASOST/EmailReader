# Email Configuration
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-app-password-here

# Email Provider (gmail, outlook, yahoo, icloud)
EMAIL_PROVIDER=outlook

# IMAP Settings (automatically set based on provider in GUI)
IMAP_SERVER=outlook.office365.com
IMAP_PORT=993

# SMTP Settings (automatically set based on provider in GUI)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587

# Azure/Microsoft 365 OAuth (OPTIONAL - for organizations that block IMAP)
# If these are set and EMAIL_PROVIDER=outlook, Graph API will be used instead of IMAP/SMTP
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Claude AI API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Summary Settings
SUMMARY_TIME=08:00
TIMEZONE=America/New_York
